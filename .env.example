# ============================================
# iSketch Clásico - Variables de Entorno
# ============================================
# Copia este archivo a .env y rellena los valores reales.
# NO subas .env a Git.
# ============================================

# ----------------------------------------
# Google AI Studio (Opcional - para IA en juego)
# ----------------------------------------
# Obtén tu clave en: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ----------------------------------------
# Servidor
# ----------------------------------------
# Puerto (la nube lo inyecta automáticamente como PORT)
# PORT=3000

# ----------------------------------------
# CORS (para producción, restringe el origen)
# ----------------------------------------
# Por defecto permite todo (cors: { origin: '*' })
# Para producción, pon tu dominio:

# ----------------------------------------
# Servidor
# ----------------------------------------
PORT=3000
NODE_ENV=production

# ----------------------------------------
# CORS (para producción, restringe el origen)
# ----------------------------------------
# Por defecto permite todo (cors: { origin: '*' })
# Para producción, pon tu dominio de GitHub Pages:
ALLOWED_ORIGIN=https://ascate142.github.io

# ----------------------------------------
# Sesión y Seguridad
# ----------------------------------------
SESSION_SECRET=genera-una-clave-secreta-larga-y-aleatoria-con-al-menos-32-caracteres

# ----------------------------------------
# Límites del Juego
# ----------------------------------------
MAX_PLAYERS=20
MAX_ROOMS=50

# ----------------------------------------
# Configuración de Salas (Opcional)
# ----------------------------------------
ROOM_PASSWORD=  # Dejar vacío para permitir acceso libre

# CORS_ORIGIN=https://tudominio.com